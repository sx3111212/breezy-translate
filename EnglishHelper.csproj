<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyName>Breezy</AssemblyName>
    <RootNamespace>EnglishHelper</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;build*\**</DefaultItemExcludes>
    <Product>轻风翻译 / Breezy Translate</Product>
    <Title>轻风翻译</Title>
    <Description>轻风翻译 · 划词查词，输入即译。Breezy Translate for Windows.</Description>
    <ApplicationIcon>Assets\translation-orb.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="app-links.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\translation-orb.png" />
    <EmbeddedResource Include="Assets\translation-orb.ico" />
    <EmbeddedResource Include="Dictionary\english-zh.json.gz" Condition="Exists('Dictionary\english-zh.json.gz')" />
    <Content Include="Dictionary\ECDICT-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
